#!/bin/bash
# Adapted from third-party MIT-licensed code; see LICENSE-THIRD-PARTY in the source repo


MONITOR_INFO=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true)')
ACTIVE_MONITOR=$(echo "$MONITOR_INFO" | jq -r '.name')
CURRENT_SCALE=$(echo "$MONITOR_INFO" | jq -r '.scale')
WIDTH=$(echo "$MONITOR_INFO" | jq -r '.width')
HEIGHT=$(echo "$MONITOR_INFO" | jq -r '.height')
REFRESH_RATE=$(echo "$MONITOR_INFO" | jq -r '.refreshRate')

# Cycle through scales: 1 → 1.25 → 1.6 → 2 → 3 → 4 → 1 (or reverse with --reverse)
SCALES=(1 1.25 1.6 2 3 4)

# Find the index of the scale closest to the current one (Hyprland may
# snap fractional scales to nearby values, so we can't match exactly)
CURRENT_IDX=$(awk -v s="$CURRENT_SCALE" -v list="${SCALES[*]}" 'BEGIN {
  n = split(list, arr, " ")
  best = 0; best_diff = 1e9
  for (i = 1; i <= n; i++) {
    d = s - arr[i]; if (d < 0) d = -d
    if (d < best_diff) { best_diff = d; best = i - 1 }
  }
  print best
}')

if [[ "$1" == "--reverse" ]]; then
  NEW_IDX=$(( (CURRENT_IDX - 1 + ${#SCALES[@]}) % ${#SCALES[@]} ))
else
  NEW_IDX=$(( (CURRENT_IDX + 1) % ${#SCALES[@]} ))
fi

NEW_SCALE=${SCALES[$NEW_IDX]}

# Lua string literal for hyprctl dispatch/eval (monitor names come from the compositor,
# but nothing here should rely on them being free of quotes or backslashes).
lua_quote() {
  local s=${1//\\/\\\\}
  printf '"%s"' "${s//\"/\\\"}"
}

hyprctl eval "hl.monitor({ output = $(lua_quote "$ACTIVE_MONITOR"), mode = $(lua_quote "${WIDTH}x${HEIGHT}@${REFRESH_RATE}"), position = \"auto\", scale = $NEW_SCALE })" >/dev/null 2>&1 ||
  hyprctl keyword monitor "$ACTIVE_MONITOR,${WIDTH}x${HEIGHT}@${REFRESH_RATE},auto,$NEW_SCALE"

# Persist to monitors.lua if the user has a single generic catch-all monitor
# (ignoring disabled ones), so the scale survives reboots.
MONITORS_LUA="$HOME/.config/hypr/monitors.lua"
CATCH_ALL='^[[:space:]]*hl\.monitor\(\{ output = "", mode = "preferred", position = "auto", scale = '
if [[ -f $MONITORS_LUA ]]; then
  mapfile -t ACTIVE_LINES < <(grep -E '^[[:space:]]*hl\.monitor\(' "$MONITORS_LUA" | grep -vE 'disabled[[:space:]]*=[[:space:]]*true')
  if [[ ${#ACTIVE_LINES[@]} -eq 1 ]] && [[ ${ACTIVE_LINES[0]} =~ $CATCH_ALL ]]; then
    sed -i -E "s/^([[:space:]]*hl\.monitor\(\{ output = \"\", mode = \"preferred\", position = \"auto\", scale = )[^ ]+( \}\))/\1${NEW_SCALE}\2/" "$MONITORS_LUA"
  fi
fi

notify-send -u low "󰍹    Display scaling set to ${NEW_SCALE}x"
