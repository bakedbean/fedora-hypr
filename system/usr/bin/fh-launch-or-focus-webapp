#!/bin/bash
# Adapted from third-party MIT-licensed code; see LICENSE-THIRD-PARTY in the source repo


if (($# == 0)); then
  echo "Usage: fh-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="fh-launch-webapp $@"

exec fh-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
