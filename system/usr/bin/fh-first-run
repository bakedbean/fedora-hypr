#!/usr/bin/env bash
# Runs from Hyprland exec-once. Once per user: pick the default theme and seed state
# dirs. Every login until done: prompt for a new password if first boot left the
# default one in place.
set -uo pipefail
: "${FH_PATH:=/usr/share/fedora-hypr}"
state="$HOME/.local/state/fedora-hypr"
marker="$state/first-run.done"

if [[ ! -f $marker ]]; then
  mkdir -p "$state/toggles/hypr" "$HOME/.config/fedora-hypr/current"
  xdg-user-dirs-update
  [[ -f $HOME/.config/fedora-hypr/current/theme.name ]] || fh-theme-set tokyo-night
  touch "$marker"
fi

# HYPEDORA screensaver wordmark, unless the user already has one (fh-branding-screensaver reset restores it)
if [[ ! -f $HOME/.config/fedora-hypr/branding/screensaver.txt ]]; then
  mkdir -p "$HOME/.config/fedora-hypr/branding"
  cp "$FH_PATH/logo.txt" "$HOME/.config/fedora-hypr/branding/screensaver.txt"
fi

# Once, after fh-migrate-hypr-lua moved this account's Hyprland config to Lua
# (before this session started): say so, and point at anything left to review.
report="$state/hypr-lua-migration.report"
if [[ -f $report ]]; then
  reviews=$(grep -c '^review ' "$report")
  if ((reviews)); then
    message="$reviews line(s) could not be converted and are commented out with FIXME. Details: $report.shown"
  else
    message="Your overrides are now ~/.config/hypr/*.lua; the old .conf files are kept as a backup."
  fi
  mv "$report" "$report.shown"
  # Give mako a moment to come up alongside us.
  (sleep 3 && notify-send -u normal "Hyprland config moved to Lua" "$message") &
fi

# After the theme step so the terminal is themed; nothing else waits on this. Both
# setup steps run in one floating terminal, password first. The time zone prompt
# repeats while the system is still on UTC and the user never confirmed a choice.
setup=()
[[ -f $state/password-change-pending ]] && setup+=(fh-setup-password)
if [[ ! -f $state/timezone.done && $(timedatectl show -p Timezone --value 2>/dev/null) == UTC ]]; then
  setup+=(fh-setup-timezone)
fi
if ((${#setup[@]})); then
  fh-launch-floating-terminal-with-presentation "$(printf '%s; ' "${setup[@]}")"
fi
exit 0
