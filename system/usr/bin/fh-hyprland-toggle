#!/bin/bash
# Adapted from third-party MIT-licensed code; see LICENSE-THIRD-PARTY in the source repo

: "${FH_PATH:=/usr/share/fedora-hypr}"

ENABLED_NOTIFICATION=""
DISABLED_NOTIFICATION=""

while [[ $# -gt 1 ]]; do
  case $1 in
    --enabled-notification) ENABLED_NOTIFICATION="$2"; shift 2 ;;
    --disabled-notification) DISABLED_NOTIFICATION="$2"; shift 2 ;;
    *) break ;;
  esac
done

FLAG_NAME="$1"
TOGGLES="$HOME/.local/state/fedora-hypr/toggles/hypr"
FLAG="$TOGGLES/$FLAG_NAME.lua"
# Toggles that carry a device or monitor name store it as data, not Lua
# (fh-toggle-touchpad, fh-hyprland-monitor-internal{,-mirror}); see default/hypr/toggles.lua.
NAME_FLAG="$TOGGLES/$FLAG_NAME.name"
FLAG_SOURCE="$FH_PATH/default/hypr/toggles/$FLAG_NAME.lua"

if [[ -f $FLAG || -f $NAME_FLAG ]]; then
  rm -f "$FLAG" "$NAME_FLAG"
  [[ -n $DISABLED_NOTIFICATION ]] && notify-send -u low "$DISABLED_NOTIFICATION"
elif [[ -f $FLAG_SOURCE ]]; then
  mkdir -p "$TOGGLES"
  cp "$FLAG_SOURCE" "$FLAG"
  [[ -n $ENABLED_NOTIFICATION ]] && notify-send -u low "$ENABLED_NOTIFICATION"
else
  echo "Flag not found: $FLAG_NAME"
  exit 1
fi

hyprctl reload
