#!/bin/bash
# Adapted from third-party MIT-licensed code; see LICENSE-THIRD-PARTY in the source repo
#
# Launch the fedora-hypr screensaver in Alacritty (the only terminal this image
# ships) on every monitor, with the correct font configuration.

if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensaver is already running
pgrep -f org.fedorahypr.screensaver && exit 0

# Allow screensaver to be turned off but also force started
if fh-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
walker --close >/dev/null 2>&1

focused=$(fh-hyprland-monitor-focused)

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hyprctl dispatch focusmonitor "$m"

  hyprctl dispatch exec -- \
    alacritty --class=org.fedorahypr.screensaver \
    --config-file /usr/share/fedora-hypr/default/alacritty/screensaver.toml \
    -e fh-screensaver
done

hyprctl dispatch focusmonitor "$focused"
