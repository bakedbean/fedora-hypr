#!/bin/bash
# Adapted from third-party MIT-licensed code; see LICENSE-THIRD-PARTY in the source repo


TOGGLE="internal-monitor-disable"
TOGGLE_FLAG="$HOME/.local/state/fedora-hypr/toggles/hypr/$TOGGLE.conf"
MIRROR_TOGGLE="internal-monitor-mirror"

# Get internal monitor name dynamically
INTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | contains("eDP")).name' | head -n 1)

enable() {
  if fh-hyprland-toggle-enabled "$TOGGLE"; then
    fh-hyprland-toggle --disabled-notification "󰍹    Laptop display enabled" "$TOGGLE"
  fi
}

disable() {
  if ! fh-hw-external-monitors; then
    notify-send -u low "󰍹    Can't disable the only active display"
    exit 1
  fi
  if fh-hyprland-toggle-disabled "$TOGGLE" && fh-hyprland-toggle-disabled "$MIRROR_TOGGLE"; then
    echo "monitor=$INTERNAL,disable" >"$TOGGLE_FLAG"
    notify-send -u low "󰍹    Laptop display disabled"
    hyprctl reload
  fi
}

recover() {
  if ! fh-hw-external-monitors && fh-hyprland-toggle-enabled "$TOGGLE"; then
    fh-hyprland-toggle "$TOGGLE"
  fi
}

case "$1" in
  on) enable ;;
  off) disable ;;
  toggle) if fh-hyprland-toggle-enabled "$TOGGLE"; then enable; else disable; fi ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
