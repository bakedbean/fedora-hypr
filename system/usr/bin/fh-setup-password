#!/usr/bin/env bash
# Change the current user's password. First boot seeds a known default ("changeme")
# and leaves a marker; fh-first-run opens this in a floating terminal until the
# password has been changed. Also reachable from fh-menu (Setup → Password).
set -uo pipefail
marker="$HOME/.local/state/fedora-hypr/password-change-pending"

echo -e "\e[32mSet a password for $USER (the initial one is 'changeme').\e[0m\n"

if passwd; then
  rm -f "$marker"
  echo -e "\e[32m\nPassword updated.\e[0m"
else
  echo -e "\e[31m\nPassword unchanged; you will be asked again at next login.\e[0m"
  exit 1
fi
