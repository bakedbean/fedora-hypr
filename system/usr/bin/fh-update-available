#!/usr/bin/env bash
# Waybar custom/update exec: prints one word and exits 0 when an update is available or
# already staged; prints nothing and exits 1 otherwise (Waybar hides a custom module whose
# exec produces empty output). Never prints a false positive: any error is logged to stderr
# and treated as "up to date".
#
# Only a definitive answer is cached. A failure (registry unreachable, sudo rule missing) exits 1
# without touching the cache, so the next poll asks again instead of trusting "none" for
# CACHE_TTL. Waybar's interval timer does not run during suspend and fires straight after resume,
# before Wi-Fi is back; so the registry lookup is retried within a budget of FH_UPDATE_NET_WAIT
# seconds, each attempt capped to what is left of it (Waybar runs exec on a worker thread per
# module, waiting does not block the bar).
set -uo pipefail

CACHE=${XDG_RUNTIME_DIR:-/tmp}/fh-update-available
CACHE_TTL=600 # seconds; keeps a pkill -RTMIN+7 waybar refresh storm off the registry
NET_WAIT=${FH_UPDATE_NET_WAIT:-90}      # total seconds to spend retrying an unreachable registry
RETRY_DELAY=${FH_UPDATE_RETRY_DELAY:-5} # seconds between attempts
ATTEMPT_MAX=30                          # seconds one skopeo attempt may take
[[ $NET_WAIT =~ ^[0-9]+$ ]] || NET_WAIT=90
[[ $RETRY_DELAY =~ ^[1-9][0-9]*$ ]] || RETRY_DELAY=5

fail() {
  # transient or setup failure: report "up to date" for this poll only, cache nothing
  echo "fh-update-available: $1" >&2
  exit 1
}

emit() {
  # $1: staged|available|none (definitive; cached for CACHE_TTL)
  printf '%s %s\n' "$(date +%s)" "$1" >"$CACHE" 2>/dev/null || true
  case $1 in
  staged | available)
    echo "$1"
    exit 0
    ;;
  *)
    exit 1
    ;;
  esac
}

if [[ -f $CACHE ]]; then
  cache_ts=
  cache_result=
  read -r cache_ts cache_result <"$CACHE" 2>/dev/null || true
  if [[ $cache_ts =~ ^[0-9]+$ ]] && (($(date +%s) - cache_ts < CACHE_TTL)); then
    case $cache_result in
    staged | available)
      echo "$cache_result"
      exit 0
      ;;
    *) exit 1 ;;
    esac
  fi
fi

# bootc status requires root; a scoped sudoers.d rule (system/etc/sudoers.d/zz-fh-update-available,
# named to sort after sudoers.d/wheel: sudo applies the last matching rule)
# grants %wheel passwordless sudo for exactly this command line. -n never prompts/hangs if that
# rule is somehow missing.
status=$(sudo -n /usr/sbin/bootc status --format json 2>/dev/null) || status=
[[ -n $status ]] || fail "sudo -n /usr/sbin/bootc status --format json failed"

staged=$(jq -r '.status.staged // empty' <<<"$status" 2>/dev/null)
if [[ -n $staged ]]; then
  emit staged
fi

booted_transport=$(jq -r '.status.booted.image.image.transport // empty' <<<"$status" 2>/dev/null)
if [[ -n $booted_transport && $booted_transport != registry ]]; then
  # e.g. bootc switch --transport containers-storage: no registry to ask, a stable answer
  emit none
fi
booted_ref=$(jq -r '.status.booted.image.image.image // empty' <<<"$status" 2>/dev/null)
booted_digest=$(jq -r '.status.booted.image.imageDigest // empty' <<<"$status" 2>/dev/null)
# unparseable or unexpected status: nothing definitive, so nothing cached
[[ -n $booted_ref && -n $booted_digest ]] || fail "no booted image ref/digest in bootc status"

start=$SECONDS
while :; do
  left=$((NET_WAIT - (SECONDS - start)))
  ((left >= 1)) || left=1
  ((left < ATTEMPT_MAX)) && attempt=$left || attempt=$ATTEMPT_MAX
  remote=$(skopeo --command-timeout "${attempt}s" inspect --no-tags "docker://$booted_ref" 2>/dev/null)
  remote_digest=$(jq -r '.Digest // empty' <<<"$remote" 2>/dev/null)
  [[ $remote_digest == sha256:* ]] && break
  ((SECONDS - start + RETRY_DELAY < NET_WAIT)) || fail "skopeo inspect of $booted_ref failed (offline?)"
  sleep "$RETRY_DELAY"
done

if [[ $remote_digest != "$booted_digest" ]]; then
  emit available
else
  emit none
fi
