[Unit]
Description=fedora-hypr first boot: install Flatpak apps
ConditionPathExists=!/var/lib/fedora-hypr/flatpaks.done
After=network-online.target fh-first-boot-user.service
Wants=network-online.target

[Service]
# simple, not oneshot: a oneshot wanted by multi-user.target holds that target (and
# graphical.target, so uwsm's session start) until the downloads finish.
Type=simple
ExecStart=/usr/bin/fh-first-boot-flatpaks
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
